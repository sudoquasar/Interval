# Copy to .env.local. Never commit the real file.

# TMDB v4 read access token. Ships in the browser bundle during Phases 1–2 (see PLAN.md §7.5).
VITE_TMDB_READ_TOKEN=

# Used by the data scripts. Falls back to VITE_TMDB_READ_TOKEN when unset.
TMDB_READ_TOKEN=

# OMDb key. Only the nightly job and local data scripts read it; it never reaches the browser.
OMDB_API_KEY=

# WATCHMODE_API_KEY=  (optional, tier-3 deep links, not used yet)
